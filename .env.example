# Base da API (docs/api/openapi.yaml)
VITE_API_URL=http://localhost:3333/v1
# true = usa os mocks do MSW no navegador (dev/homologação)
VITE_API_MOCK=true
# Integração gradual com a API real: só estes módulos continuam simulados (vazio = todos)
# auth, me, groups, invites, matches, payments, live, sports
VITE_API_MOCK_ONLY=
# Domínio público do app, usado nos links de convite e no QR Code
VITE_APP_URL=http://localhost:5173
# Versão dos termos aceitos no cadastro
VITE_TERMS_VERSION=2026-11

# Contato do encarregado de dados (LGPD), exibido na política de privacidade
VITE_PRIVACY_CONTACT=privacidade@dajogo.app

# Modo demonstração (/demo): impressão digital da senha (gere com: pnpm demo:senha "sua senha").
# Vazio = demonstração fechada.
VITE_DEMO_PASSWORD_HASH=
# Por quantos dias os dados da demonstração ficam salvos no aparelho
VITE_DEMO_DAYS=30
